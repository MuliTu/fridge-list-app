# Public Firebase web config. These values are not secrets, but they are environment
# specific and should be configured by each deployment.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Server Firebase configuration.
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Prisma / relational database schema target.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/fridge_list?schema=public"

# Server-only RDS rollout flags. Leave false unless explicitly testing RDS paths.
RDS_ENABLED=false
RDS_GROCERY_READS_ENABLED=false

# n8n / automation webhooks. Use stable production URLs, not temporary tunnel URLs.
CATEGORIZE_ITEM_WEBHOOK_URL=
SUBMIT_FEEDBACK_WEBHOOK_URL=
RECEIPT_SCAN_URL=
RECEIPT_URL_SCAN_ENDPOINT=
PURCHASE_HABIT_SUMMARY_WEBHOOK_URL=

# Machine-to-machine n8n write API.
N8N_WRITE_SECRET=
N8N_ALLOWED_LIST_ID=

# Optional integrations.
GITHUB_RELEASES_TOKEN=
CRON_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
